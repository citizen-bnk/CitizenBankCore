# Configure actual values in Vercel for both Preview and Production. Never commit keys.
DATABASE_URL=postgresql://user:password@localhost:5432/citizenbank
DATABASE_URL_UNPOOLED=postgresql://user:password@localhost:5432/citizenbank
AUTH_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-a-long-random-secret
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_EN=
ELEVENLABS_VOICE_ST=
ELEVENLABS_VOICE_ZU=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral

# Demo behaviour
DEMO_MODE=true
DEMO_PASSWORD=Citizen2026!
SEED_DEMO_DATA=true
ALLOW_REGISTRATION=true

# Single sign-on from the Citizen Bank website (leave unset to keep SSO switched off).
# The website publishes its public keys at <website>/api/platform/jwks.json. Core only verifies; it holds no signing key.
PLATFORM_JWKS_URL=
PLATFORM_ISSUER=
# Which handoff audiences this Core accepts (the website issues "banking" and "app").
SSO_AUDIENCES=banking,app
