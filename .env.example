# Postgres (Vercel + Neon sets these automatically)
DATABASE_URL="postgresql://user:password@localhost:5432/citizen"
DATABASE_URL_UNPOOLED="postgresql://user:password@localhost:5432/citizen"

# 32+ random characters — signs session cookies
AUTH_SECRET="replace-with-a-long-random-string-at-least-32-chars"
# Bearer token Vercel Cron sends to /api/cron/scheduled-payments
CRON_SECRET="replace-me"
# Frontend origins allowed to make state-changing requests (comma-separated)
ALLOWED_ORIGINS="http://localhost:3000,http://localhost:3001"

# Citizen AI (Claude API)
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Demo behaviour
DEMO_MODE="true"
DEMO_PASSWORD="Citizen2026!"
SEED_DEMO_DATA="true"
ALLOW_REGISTRATION="true"

# Optional: real voices via ElevenLabs
ELEVENLABS_API_KEY=""
ELEVENLABS_VOICE_EN=""
ELEVENLABS_VOICE_ST=""
ELEVENLABS_VOICE_ZU=""
